# ==============================================================================
# Virtual Travel Agent - Environment Variables Template
# Copy this file to backend/.env (or root .env) and fill in your keys.
# DO NOT COMMIT THE ACTUAL .env FILE!
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Geoapify Places & Geocoding API
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Ignav Flight API Configuration
IGNAV_API_KEY=your_ignav_api_key_here
IGNAV_BASE_URL=https://ignav.com/api

# Nuitee Connect (LiteAPI) Hotel API Configuration
NUITEE_API_KEY=your_nuitee_api_key_here
NUITEE_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOK_BASE_URL=https://book.liteapi.travel/v3.0

# Amadeus Travel API (Optional - Mocks used if empty)
AMADEUS_CLIENT_ID=your_amadeus_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret_here
AMADEUS_HOSTNAME=test.api.amadeus.com

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Routing & Maps (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org
USE_MOCK_DATA=True

