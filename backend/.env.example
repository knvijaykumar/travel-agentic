# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Geoapify Places & Geocoding API
GEOAPIFY_API_KEY=

# Ignav Flight API Configuration
IGNAV_API_KEY=
IGNAV_BASE_URL=https://ignav.com/api

# Nuitee Connect (LiteAPI) Hotel API Configuration
NUITEE_API_KEY=
NUITEE_BASE_URL=https://api.liteapi.travel/v3.0
NUITEE_BOOK_BASE_URL=https://book.liteapi.travel/v3.0

# Amadeus API (Accommodation & Transport)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com

# Supabase PostgreSQL
SUPABASE_URL=
SUPABASE_KEY=

# Routing & Mapping
OSRM_BASE_URL=https://router.project-osrm.org
USE_MOCK_DATA=True

